# Infrastructure credentials only. Everything an operator can change through the
# interface lives in the settings store, not here.

# --- Application ---
APP_NAME=Shorty-Nah
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.example.com
APP_DOMAIN=admin.example.com
APP_TIMEZONE=UTC

# --- Internal network ---
# Pins the Compose network and, from the same value, the set of peers whose
# forwarding headers the application will trust. Never widen this to a wildcard:
# a trusted wildcard lets any client spoof its address, which defeats redirect
# rate limiting and forges every geographic figure.
INTERNAL_SUBNET=172.29.0.0/16

# --- Edge / TLS ---
CADDY_ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443

# --- Octane ---
OCTANE_SERVER=frankenphp
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# --- Postgres ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=shortynah
DB_USERNAME=shortynah
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=shortynah_events
CLICKHOUSE_WRITE_USERNAME=shortynah_writer
CLICKHOUSE_WRITE_PASSWORD=
CLICKHOUSE_READ_USERNAME=shortynah_reader
CLICKHOUSE_READ_PASSWORD=

# --- MaxMind GeoLite2 ---
# Free licence key from https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_EDITION_IDS="GeoLite2-City GeoLite2-ASN"

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=https://admin.example.com
INTERNAL_API_URL=http://api:8000

# Encrypts backup artefacts. Losing it makes every backup unreadable.
BACKUP_KEY=
